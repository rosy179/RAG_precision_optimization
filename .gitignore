# --- Python cache/bytecode ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Packaging / build ---
build/
dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Jupyter ---
.ipynb_checkpoints/

# --- OS/editor files ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Secrets / environment ---
.env
.env.*
!.env.example

# --- Logs and temporary files ---
*.log
tmp/
temp/

# --- Node ---
node_modules/

# --- Project generated data/artifacts ---
data/chroma_db*/
data/*.json
data/webapp.db
results/*.json
backend/uploads/
backend_startup.log*

# --- Keep git for directory structure ---
!data/.gitkeep
!results/.gitkeep
# Golden set for the eval-regression CI must be tracked (not a generated artifact)
!data/golden_regression.json
.claude/