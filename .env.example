# ============================================================
# RAG Precision Optimization — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys
# NEVER commit .env to git!

# --- OpenAI (for LLM + Embeddings) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- HuggingFace (optional, for higher rate limits) ---
HF_TOKEN=hf_your-token-here

# --- RAG Configuration ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=3
RETRIEVE_DEPTH=20
# Embedding đa ngôn ngữ chạy local (miễn phí). Đổi model xong phải chạy
# scripts/reembed_collections.py. Cũng nhận model OpenAI: text-embedding-3-large
EMBED_MODEL=BAAI/bge-m3
# Reranker cross-encoder đa ngôn ngữ chạy local (~120MB, nhanh trên CPU).
# Máy GPU nên đổi sang BAAI/bge-reranker-v2-m3 (mạnh hơn, quá chậm trên CPU)
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
LLM_MODEL=gpt-4o-mini
