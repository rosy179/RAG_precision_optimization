# ============================================================
# RAG Precision Optimization — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your API keys
# NEVER commit .env to git!

# --- OpenAI (for LLM + Embeddings) ---
OPENAI_API_KEY=sk-your-openai-key-here

# --- HuggingFace (optional, for higher rate limits) ---
HF_TOKEN=hf_your-token-here

# --- RAG Configuration ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=3
RETRIEVE_DEPTH=20
# Embedding đa ngôn ngữ chạy local (miễn phí). Đổi model xong phải chạy
# scripts/reembed_collections.py. Cũng nhận model OpenAI: text-embedding-3-large
EMBED_MODEL=BAAI/bge-m3
# Reranker cross-encoder đa ngôn ngữ chạy local (~120MB, nhanh trên CPU).
# Máy GPU nên đổi sang BAAI/bge-reranker-v2-m3 (mạnh hơn, quá chậm trên CPU)
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
LLM_MODEL=gpt-4o-mini
# Đổi provider LLM: để trống = OpenAI. Trỏ tới endpoint OpenAI-compatible để
# dùng Ollama/vLLM cục bộ, ví dụ http://localhost:11434/v1 (đặt OPENAI_API_KEY
# thành chuỗi bất kỳ như "ollama" để bật gọi thật).
LLM_BASE_URL=
# Contextual Retrieval (kiểu Anthropic): khi ingest, LLM sinh 1 câu ngữ cảnh
# cho mỗi chunk, ghép trước khi embed + BM25 (text gốc vẫn được lưu/hiển thị).
# Đặt =0 để tắt. Đổi giá trị này phải re-ingest tài liệu.
CONTEXTUAL_RETRIEVAL=1
